doctype html
html(lang="da")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Yatzy - Forside
        link(rel="stylesheet", href="/forside.css")

    body 
        main.forside
            h1 Velkommen til Yatzy-spillet! 
            p Spil Yatzy og se de andre tilmeldte spillere.
            
            h2 Tilmeld dig spillet

            if currentPlayer
                p Du er tilmeldt som #{currentPlayer}
                a(href="/game") Fortsæt til spillet
            else
                form(action="/join", method="POST")
                    label(for="name") Indtast spillernavn: 
                    input#name(type="text", name="name", maxLength="30", required)
                    button(type="submit") Start spil


            h2 Tilmeldte spillere:

            if players.length > 0
                ul
                    each player in players
                        li= player

            else
                p Der er ingen spillere endnu



            
